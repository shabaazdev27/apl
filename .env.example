# ── CricketMind AI — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# REQUIRED: Gemini API key from Google AI Studio
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use — must be one of the models your key has access to.
# Run: node check-models.mjs  to see what your key supports.
# Default (recommended): gemini-2.0-flash
# Options: gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.0-flash

# GCP project for Vertex AI (used when no GEMINI_API_KEY is set)
# GOOGLE_CLOUD_PROJECT=your-project-id

# Public URL of this application
APP_URL=
